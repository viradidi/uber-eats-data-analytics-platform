{
  "name": "sql_incremental pipeline",
  "properties": {
    "activities": [
      {
        "name": "Lookup_SQL_Control",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "Select * from pipeline_control ",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "DS_sql_control",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEach item",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Lookup_SQL_Control",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup_SQL_Control').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "Check any new data",
              "description": "",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "@concat(\n    'SELECT COUNT(*) AS row_count FROM dbo.',\n    item().table_name,\n    ' WHERE ',\n    item().watermark_column,\n    ' > ''',\n    item().last_watermark_value,\n    ''''\n)",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "dataset": {
                  "referenceName": "ds_sql",
                  "type": "DatasetReference",
                  "parameters": {
                    "p_table_name": {
                      "value": "@item().table_name",
                      "type": "Expression"
                    }
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "rowscount is there",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "Check any new data",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "userProperties": [],
              "typeProperties": {
                "expression": {
                  "value": "@greater(activity('Check any new data').output.firstRow.row_count,0)",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "adls data migration_copy1",
                    "type": "Copy",
                    "dependsOn": [
                      {
                        "activity": "Get max watermark_copy1",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "source": {
                        "type": "AzureSqlSource",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None",
                        "sqlReaderQuery": {
                          "value": "@concat(\n    'SELECT * FROM dbo.',\n    item().table_name,\n    ' WHERE ',\n    item().watermark_column,\n    ' > ''',\n    item().last_watermark_value,\n    ''' AND ',\n    item().watermark_column,\n    ' <= ''',\n    activity('Get max watermark_copy1').output.firstRow.max_watermark,\n    ''''\n)",
                          "type": "Expression"
                        }
                      },
                      "sink": {
                        "type": "DelimitedTextSink",
                        "storeSettings": {
                          "type": "AzureBlobFSWriteSettings"
                        },
                        "formatSettings": {
                          "type": "DelimitedTextWriteSettings",
                          "quoteAllText": true,
                          "fileExtension": ".txt"
                        }
                      },
                      "enableStaging": false,
                      "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                          "allowDataTruncation": true,
                          "treatBooleanAsNumber": false
                        }
                      }
                    },
                    "inputs": [
                      {
                        "referenceName": "ds_sql",
                        "type": "DatasetReference",
                        "parameters": {
                          "p_table_name": {
                            "value": "@item().table_name",
                            "type": "Expression"
                          }
                        }
                      }
                    ],
                    "outputs": [
                      {
                        "referenceName": "ds_adls",
                        "type": "DatasetReference",
                        "parameters": {
                          "p_file_name": {
                            "value": "@concat(item().table_name,'_',formatDateTime(utcNow(),'yyyyMMdd_HHmmss'),'.csv')",
                            "type": "Expression"
                          },
                          "p_folder_path": {
                            "value": "@item().table_name",
                            "type": "Expression"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "name": "Get max watermark_copy1",
                    "type": "Lookup",
                    "dependsOn": [],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                          "value": "@concat('SELECT MAX(', item().watermark_column, ') AS max_watermark FROM dbo.', item().table_name)",
                          "type": "Expression"
                        },
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                      },
                      "dataset": {
                        "referenceName": "ds_sql_water",
                        "type": "DatasetReference"
                      }
                    }
                  },
                  {
                    "name": "update watermark_copy1",
                    "type": "Script",
                    "dependsOn": [
                      {
                        "activity": "Job_Silver_copy1",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "linkedServiceName": {
                      "referenceName": "ls_sql_database",
                      "type": "LinkedServiceReference"
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "Query",
                          "text": {
                            "value": "@concat(\n    'UPDATE dbo.pipeline_control SET last_watermark_value = ''',\n    activity('Get max watermark_copy1').output.firstRow.max_watermark,\n    ''' WHERE control_id = ',\n    item().control_id,\n    ' AND last_watermark_value = ''',\n    item().last_watermark_value,\n    '''; IF @@ROWCOUNT <> 1 THROW 51001, ''Checkpoint conflict: control row changed or was not unique.'', 1;'\n)",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  },
                  {
                    "name": "Job_Silver_copy1",
                    "type": "DatabricksJob",
                    "dependsOn": [
                      {
                        "activity": "adls data migration_copy1",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "jobId": "121055824417886",
                      "jobParameters": {
                        "table_name": {
                          "value": "@item().table_name",
                          "type": "Expression"
                        }
                      }
                    },
                    "linkedServiceName": {
                      "referenceName": "LS_db_silver",
                      "type": "LinkedServiceReference"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "annotations": [],
    "lastPublishTime": "2026-09-02T07:33:55Z",
    "concurrency": 1
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
