{
  "name": "uber_eats_master",
  "properties": {
    "description": "Runs API, CSV, and SQL ingestion, then publishes Gold analytics only after all ingestion branches succeed.",
    "activities": [
      {
        "name": "Run_API_Ingestion",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "api_src_inital load",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true
        }
      },
      {
        "name": "Run_CSV_Ingestion",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "csv_initial load",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true
        }
      },
      {
        "name": "Run_SQL_Ingestion",
        "type": "ExecutePipeline",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "pipeline": {
            "referenceName": "sql_incremental pipeline",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "parent_pipeline_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Publish_Gold_Analytics",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Run_API_Ingestion",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Run_CSV_Ingestion",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Run_SQL_Ingestion",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "notebookPath": "/Shared/UberEats/notebooks/Gold_Analytics",
          "baseParameters": {
            "pipeline_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        },
        "linkedServiceName": {
          "referenceName": "ls_api_adb",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "parameters": {},
    "annotations": [
      "Gold layer orchestration"
    ],
    "concurrency": 1
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
